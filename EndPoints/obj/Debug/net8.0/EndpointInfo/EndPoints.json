            "minLength": 0,
            "type": "string"
          },
          "billAmount": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "maxLength": 2147483647,
            "minLength": 0,
            "type": "string"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "paidById": {
